# --- LLM (Gemini via its OpenAI-compatible endpoint) ---
# Never commit real keys. Copy this file to .env and fill in values.
GEMINI_API_KEY=
# Any OpenAI-compatible endpoint works; defaults target Gemini.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
# Set to false to force rule-only scoring (useful for tests / offline runs)
LLM_ENABLED=true

# --- GitHub enrichment (optional but recommended; raises API rate limits) ---
GITHUB_TOKEN=
# Set to false to skip GitHub enrichment entirely
GITHUB_ENABLED=true

# --- Runtime behaviour ---
MAX_WORKERS=4            # bounded concurrency for LLM + GitHub calls
LLM_TIMEOUT_SECONDS=30
GITHUB_TIMEOUT_SECONDS=10
